{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "lockFileMaintenance": {
        "enabled": true
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^infra/fridge/(access|isolated)-cluster/enums/__init__\\.py$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-zA-Z0-9_-]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?\\s+[A-Z0-9_]+\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
            ]
        }
    ],
    "packageRules": [
        {
            "matchFileNames": [
                "fridge-job-api/**"
            ],
            "matchManagers": [
                "pep621"
            ],
            "groupName": "FRIDGE API Python Dependencies",
            "groupSlug": "fridge-job-api-python"
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "groupName": "FRIDGE K8s Stack",
            "groupSlug": "fridge-k8s-stack"
        }
    ]
}
